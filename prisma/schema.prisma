generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  nameEn         String?
  password       String
  role           String    @default("STUDENT")
  status         String    @default("PENDING")
  cohort         Int?
  major          String?
  currentCity    String?
  currentCountry String?
  bio            String?
  linkedinUrl    String?
  instagramUrl   String?
  graduationYear Int?
  company        String?
  jobTitle       String?
  isPublic       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  events                 Event[]
  approvedBy             User?           @relation("Approvals", fields: [approvedById], references: [id])
  approvedById           String?
  approvals              User[]          @relation("Approvals")
  sentMentorRequests     MentorRequest[] @relation("SentRequests")
  receivedMentorRequests MentorRequest[] @relation("ReceivedRequests")

  @@map("users")
}

model Post {
  id        String    @id @default(cuid())
  title     String
  content   String
  category  String    @default("GENERAL")
  isPinned  Boolean   @default(false)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  isDeleted Boolean   @default(false)
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")
  likes     Like[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model MentorRequest {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SentRequests", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReceivedRequests", fields: [toUserId], references: [id])
  message    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId])
  @@map("mentor_requests")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String?
  isOnline    Boolean   @default(false)
  startDate   DateTime
  endDate     DateTime?
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("events")
}

model Project {
  id          String           @id @default(cuid())
  title       String
  description String
  tags        String?
  status      String           @default("ONGOING")
  teamMembers String?
  demoUrl     String?
  githubUrl   String?
  order       Int              @default(0)
  comments    ProjectComment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("projects")
}

model ProjectComment {
  id          String   @id @default(cuid())
  content     String
  authorName  String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("project_comments")
}

model LearningContent {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   @default("COURSE")
  instructor  String?
  tags        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("learning_contents")
}

model ActivityContent {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   @default("SESSION")
  date        String?
  tags        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activity_contents")
}
